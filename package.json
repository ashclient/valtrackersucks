{
  "name": "valtrackersucks",
  "version": "0.2.0",
  "private": true,
  "description": "Fast, privacy-aware VALORANT desktop companion",
  "main": "electron/main.cjs",
  "author": "ashclient",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "dist:win": "npm run generate:icons && electron-builder --win portable nsis --x64 --publish never",
    "generate:icons": "node scripts/generate-icons.cjs",
    "serve:rso": "node server/rso-server.cjs"
  },
  "devDependencies": {
    "electron": "45.2.1",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "xyz.ashclient.vts",
    "productName": "VTS",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      "src/**/*",
      "assets/icon.ico",
      "assets/icon.png",
      "package.json",
      "README.md"
    ],
    "win": {
      "target": [
        "portable",
        "nsis"
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "extraMetadata": {
      "description": "VTS independent VALORANT desktop companion"
    }
  }
}
