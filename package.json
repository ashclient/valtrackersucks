{
  "name": "valtrackersucks",
  "version": "0.1.0",
  "private": true,
  "description": "Fast, privacy-aware VALORANT desktop companion",
  "main": "electron/main.cjs",
  "author": "ashclient",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "dist:win": "electron-builder --win portable nsis --x64 --publish never"
  },
  "devDependencies": {
    "electron": "45.2.1",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "xyz.ashclient.vts",
    "productName": "VTS",
    "asar": true,
    "directories": { "output": "dist" },
    "files": ["electron/**/*", "src/**/*", "package.json", "README.md"],
    "win": { "target": ["portable", "nsis"] },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true }
  }
}
