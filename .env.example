# RSO: server-only configuration (never put these secrets in the desktop installer)
# First register VTS and obtain a production application and RSO client from Riot.
RIOT_RSO_CLIENT_ID=APPROVED_RSO_CLIENT_ID
RIOT_RSO_CLIENT_SECRET=APPROVED_RSO_CLIENT_SECRET
RIOT_RSO_REDIRECT_URI=https://api.your-domain.example/oauth/callback
RIOT_API_KEY=APPROVED_RIOT_PRODUCTION_API_KEY
VTS_PUBLIC_URL=https://api.your-domain.example
PORT=8799
VTS_BIND_HOST=127.0.0.1

# Desktop app only, when that backend has been deployed behind HTTPS:
# VTS_API_BASE_URL=https://api.your-domain.example
